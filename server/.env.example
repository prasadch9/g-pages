NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-domain.com

# Database
MONGO_URI=your-mongodb-atlas-uri
DNS_SERVERS=1.1.1.1,8.8.8.8

# Auth
JWT_SECRET=your-long-random-secret-min-64-chars
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Media uploads — set to the public backend URL so uploaded file links are correct
PUBLIC_API_URL=https://api.your-domain.com

# Image storage (Cloudinary — optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="App Name <your-email@gmail.com>"

# Maps (optional)
GOOGLE_MAPS_API_KEY=

# Seed (optional, development only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_MOBILE=9999999999
